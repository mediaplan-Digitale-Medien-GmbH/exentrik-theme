{% doc %}
  @prompt
    einen seo block text mit 3 spalten 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-seo-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-seo-text__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-seo-text__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-seo-text__subheading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.columns_spacing }}px;
    font-size: {{ block.settings.subheading_size }}px;
  }

  .ai-seo-text__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.columns_spacing }}px;
  }

  .ai-seo-text__column-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-seo-text__column-{{ ai_gen_id }} h3 {
    color: {{ block.settings.column_heading_color }};
    font-size: {{ block.settings.column_heading_size }}px;
    margin: 0 0 {{ block.settings.column_heading_spacing }}px;
  }

  .ai-seo-text__column-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-seo-text__column-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-seo-text__column-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-seo-text__column-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-seo-text__columns-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-seo-text__columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-seo-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-seo-text__column-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.column_heading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-seo-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-seo-text__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-seo-text__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-seo-text__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    <div class="ai-seo-text__columns-{{ ai_gen_id }}">
      <div class="ai-seo-text__column-{{ ai_gen_id }}">
        {% if block.settings.column_1_heading != blank %}
          <h3>{{ block.settings.column_1_heading }}</h3>
        {% endif %}
        {% if block.settings.column_1_text != blank %}
          {{ block.settings.column_1_text }}
        {% else %}
          <p>Fügen Sie hier Ihren SEO-optimierten Text für die erste Spalte hinzu.</p>
        {% endif %}
      </div>

      <div class="ai-seo-text__column-{{ ai_gen_id }}">
        {% if block.settings.column_2_heading != blank %}
          <h3>{{ block.settings.column_2_heading }}</h3>
        {% endif %}
        {% if block.settings.column_2_text != blank %}
          {{ block.settings.column_2_text }}
        {% else %}
          <p>Fügen Sie hier Ihren SEO-optimierten Text für die zweite Spalte hinzu.</p>
        {% endif %}
      </div>

      <div class="ai-seo-text__column-{{ ai_gen_id }}">
        {% if block.settings.column_3_heading != blank %}
          <h3>{{ block.settings.column_3_heading }}</h3>
        {% endif %}
        {% if block.settings.column_3_text != blank %}
          {{ block.settings.column_3_text }}
        {% else %}
          <p>Fügen Sie hier Ihren SEO-optimierten Text für die dritte Spalte hinzu.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SEO Text 3 Spalten",
  "settings": [
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Hauptüberschrift"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Ausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spalte 1"
    },
    {
      "type": "inline_richtext",
      "id": "column_1_heading",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "column_1_text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Spalte 2"
    },
    {
      "type": "inline_richtext",
      "id": "column_2_heading",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "column_2_text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Spalte 3"
    },
    {
      "type": "inline_richtext",
      "id": "column_3_heading",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "column_3_text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max. Inhaltsbreite",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Spalten auf Tablet",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Abstand zwischen Spalten",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Abstand seitlich",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Abstand nach Hauptüberschrift",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_spacing",
      "label": "Abstand vor Spalten",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_heading_spacing",
      "label": "Abstand nach Spaltenüberschrift",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Abstand zwischen Absätzen",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Hauptüberschrift",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "column_heading_color",
      "label": "Spaltenüberschriften",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#c52f3e"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links bei Hover",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Hauptüberschrift Größe",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Unterüberschrift Größe",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "column_heading_size",
      "label": "Spaltenüberschrift Größe",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Größe",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Zeilenhöhe",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    }
  ],
  "presets": [
    {
      "name": "SEO Text 3 Spalten"
    }
  ]
}
{% endschema %}