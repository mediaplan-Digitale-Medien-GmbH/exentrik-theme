<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_ember | default: '#e3341e' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ shop.name | escape }}">
    <meta property="og:description" content="{{ shop.description | default: shop.name | escape }}">
    {{ content_for_header }}

    {% style %}
      :root {
        --color-bg: {{ settings.color_background | default: '#f3f1ee' }};
        --color-ink: {{ settings.color_text | default: '#0a0a0a' }};
        --color-ink-soft: {{ settings.color_text_muted | default: '#5a5752' }};
        --color-ember: {{ settings.color_ember | default: '#e3341e' }};
        --color-flame: {{ settings.color_flame | default: '#ffeb00' }};
        --color-surface: {{ settings.color_surface | default: '#ebe7e1' }};
        --color-text: {{ settings.color_text | default: '#0a0a0a' }};
        --color-text-muted: {{ settings.color_text_muted | default: '#5a5752' }};
        --color-border: {{ settings.color_border | default: '#ddd7ce' }};
        --color-accent: {{ settings.color_accent | default: '#e3341e' }};
        --color-accent-text: {{ settings.color_accent_text | default: '#ffffff' }};
        --font-body: 'Outfit', system-ui, sans-serif;
        --font-display: 'Archivo Black', system-ui, sans-serif;
        --radius: {{ settings.corner_radius | default: 10 }}px;
        --btn-radius: 999px;
        --page-width: {{ settings.page_width | default: 1180 }}px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>
  <body class="template-password">
    <main id="MainContent" class="main-content" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
