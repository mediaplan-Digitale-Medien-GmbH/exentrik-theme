{%- comment -%}
  Alte Seitenvorlage. Der Seitenbaukasten liegt in sections/page-body.liquid,
  diese Datei bleibt nur als Rueckfallebene bestehen und wird nicht mehr genutzt.
{%- endcomment -%}
<div class="page-width page-width--narrow section">
  {%- if page.title != blank -%}
    <header class="section-header" reveal>
      <h1>{{ page.title }}</h1>
    </header>
  {%- endif -%}
  {%- if page.content != blank -%}
    <div class="rte" reveal>{{ page.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Seite (alt)",
  "tag": "section",
  "settings": []
}
{% endschema %}
