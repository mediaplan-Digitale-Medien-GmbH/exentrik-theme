<div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    <div class="announcement-bar__inner" data-announcement-rotator>
      {%- for block in section.blocks -%}
        <span class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {% render 'icon', name: block.settings.icon %}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-announcement-rotator]');
    if (!root) return;
    var items = root.querySelectorAll('.announcement-bar__item');
    if (items.length < 2) return;
    var i = 0;
    setInterval(function () {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, 4000);
  })();
</script>

{% schema %}
{
  "name": "Ankündigungsleiste",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Hintergrund", "default": "#0d1117" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f4f6f8" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Hinweis",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Versandkostenfrei ab 59 Euro" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "options": [
            { "value": "none", "label": "Kein" },
            { "value": "truck", "label": "Versand" },
            { "value": "shield", "label": "Schutz" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "credit-card", "label": "Zahlung" },
            { "value": "check", "label": "Haken" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ankündigungsleiste",
      "blocks": [
        { "type": "item", "settings": { "text": "Versandkostenfrei ab 59 Euro innerhalb Deutschlands", "icon": "truck" } },
        { "type": "item", "settings": { "text": "3 Prozent Rabatt bei Vorkasse", "icon": "credit-card" } },
        { "type": "item", "settings": { "text": "Kauf auf Rechnung möglich", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
