{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_ratio = section.settings.media_ratio | default: 'square'
  case gallery_ratio
    when 'natural'
      assign gallery_ratio_css = ''
    when 'portrait_45'
      assign gallery_ratio_css = '4 / 5'
    when 'portrait_34'
      assign gallery_ratio_css = '3 / 4'
    when 'landscape_43'
      assign gallery_ratio_css = '4 / 3'
    when 'landscape_169'
      assign gallery_ratio_css = '16 / 9'
    else
      assign gallery_ratio_css = '1 / 1'
  endcase
  assign gallery_fit = section.settings.media_fit | default: 'cover'
  assign gallery_thumbs = section.settings.thumbs_per_row | default: 5
  assign gallery_thumb_pos = section.settings.thumb_position | default: 'left'
  assign gallery_thumb_w = section.settings.thumb_width | default: 88
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

{%- comment -%}
  Beschreibung und Aufklapp-Bloecke werden einmal gebaut und je nach
  Einstellung entweder in der rechten Produktspalte oder in voller Breite
  unter dem Produkt ausgegeben.
{%- endcomment -%}
{%- assign desc_pos = section.settings.description_position | default: 'right' -%}
{%- capture product_accordion -%}
  <div class="product-accordion">
    {%- if product.description != blank -%}
      <details class="product-accordion__item" open>
        <summary class="product-accordion__summary">{{ 'products.product.description' | t }} {% render 'icon', name: 'chevron-down' %}</summary>
        <div class="product-accordion__content rte">{{ product.description }}</div>
      </details>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'collapsible' -%}
        <details class="product-accordion__item" {{ block.shopify_attributes }}>
          <summary class="product-accordion__summary">{{ block.settings.title }} {% render 'icon', name: 'chevron-down' %}</summary>
          <div class="product-accordion__content rte">{{ block.settings.content }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endcapture -%}

<div class="page-width product-page" data-variant-selector>
  <nav class="breadcrumb text-muted" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Start</a>
    {%- if collection %} <span>/</span> <a href="{{ collection.url }}">{{ collection.title }}</a>{%- endif -%}
    <span>/</span> <span>{{ product.title | truncate: 50 }}</span>
  </nav>

  <div class="product">
    {%- comment -%} -------------------------- Gallery -------------------------- {%- endcomment -%}
    <div class="product-gallery{% if gallery_ratio_css != blank %} product-gallery--ratio{% endif %}{% if gallery_thumb_pos == 'left' %} product-gallery--left{% endif %}" data-gallery style="--pg-fit: {{ gallery_fit }}; --pg-thumbs: {{ gallery_thumbs }}; --pg-thumb-w: {{ gallery_thumb_w }}px;{% if gallery_ratio_css != blank %} --pg-ratio: {{ gallery_ratio_css }};{% endif %}">
      <div class="product-gallery__main media">
        {%- if product.featured_media -%}
          <img
            data-gallery-main
            src="{{ product.featured_media | image_url: width: 1200 }}"
            srcset="{{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w, {{ product.featured_media | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 990px) 100vw, 55vw"
            alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            loading="eager">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        {%- comment -%}
          Die Schiene ist der eigentliche Rasterplatz. Steht die Leiste links,
          liegen die Vorschaubilder absolut darin und scrollen deshalb genau
          auf Hoehe des grossen Bildes, statt es in die Laenge zu ziehen.
        {%- endcomment -%}
        <div class="product-gallery__rail">
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="product-gallery__thumb {% if forloop.first %}is-active{% endif %}"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              data-full="{{ media | image_url: width: 1200 }}"
              data-srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w"
              aria-label="Bild {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} -------------------------- Info -------------------------- {%- endcomment -%}
    <div class="product-info {% if settings.product_sticky_info %}product-info--sticky{% endif %}">
      {%- comment -%}
        Markenzeile ueber dem Titel. Es gewinnt das erste gefuellte Metafeld aus
        vendor_metafield_keys, gesucht zuerst an der Variante, dann am Produkt.
        Ist keines gefuellt, greift der Anbieter aus dem Produkt.
      {%- endcomment -%}
      {%- assign vendor_text = '' -%}
      {%- assign vendor_ns = section.settings.vendor_metafield_namespace | default: 'custom' -%}
      {%- assign vendor_keys = section.settings.vendor_metafield_keys | default: 'hersteller,marke' | split: ',' -%}
      {%- for vendor_raw_key in vendor_keys -%}
        {%- if vendor_text == blank -%}
          {%- assign vendor_key = vendor_raw_key | strip -%}
          {%- if vendor_key != blank -%}
            {%- assign vendor_mf = current_variant.metafields[vendor_ns][vendor_key] -%}
            {%- capture vendor_val -%}{{ vendor_mf }}{%- endcapture -%}
            {%- assign vendor_val = vendor_val | strip -%}
            {%- if vendor_val == blank or vendor_val == 'null' -%}
              {%- assign vendor_mf = product.metafields[vendor_ns][vendor_key] -%}
              {%- capture vendor_val -%}{{ vendor_mf }}{%- endcapture -%}
              {%- assign vendor_val = vendor_val | strip -%}
            {%- endif -%}
            {%- if vendor_val != blank and vendor_val != 'null' -%}
              {%- assign vendor_text = vendor_val -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if vendor_text == blank -%}
        {%- assign vendor_text = product.vendor -%}
      {%- endif -%}
      {%- if vendor_text != blank and section.settings.show_vendor -%}
        <div class="product-info__vendor">{{ vendor_text }}</div>
      {%- endif -%}
      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- comment -%}
        App-Bloecke stehen zwischen Titel und Preis, weil dort das Bewertungs-
        Badge von Judge.me erwartet wird. Sie laufen deshalb nicht mehr in der
        Blockschleife am Ende der Spalte mit.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="product-app-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      <div class="product-info__price" data-price>
        {%- if on_sale -%}
          <span class="price price--on-sale"><span class="price__sale">{{ current_variant.price | money }}</span> <span class="price__regular">{{ current_variant.compare_at_price | money }}</span></span>
        {%- else -%}
          <span class="price">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>
      <div class="product-info__unit price__unit" data-unit-price {% unless current_variant.unit_price_measurement %}hidden{% endunless %}>
        {%- if current_variant.unit_price_measurement -%}{% render 'unit-price', variant: current_variant %}{%- endif -%}
      </div>

      <div class="product-info__tax">{{ 'products.product.incl_tax' | t }}, {{ 'products.product.plus_shipping' | t }}</div>
      {%- if section.settings.price_note != blank -%}
        <p class="product-info__price-note">{{ section.settings.price_note }}</p>
      {%- endif -%}

      <div class="stock-status {% if current_variant.available %}stock-status--in{% else %}stock-status--out{% endif %}" data-stock>
        <span class="stock-status__dot"></span>
        {% if current_variant.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.out_of_stock' | t }}{% endif %}
      </div>

      {%- comment -%} -------------------------- Form -------------------------- {%- endcomment -%}
      {% form 'product', product, data-product-form: true, data-ajax-cart: true %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {% render 'variant-picker', product: product, section_id: section.id, style: section.settings.variant_style %}

        <div class="quantity-row">
          <div class="quantity-selector" data-quantity>
            <button type="button" data-qty-step="-1" aria-label="Menge verringern">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-step="1" aria-label="Menge erhöhen">+</button>
          </div>
        </div>

        <div class="product-form__buttons">
          <button type="submit" name="add" class="btn btn--primary btn--atc btn--large btn--full" data-add-btn {% unless current_variant.available %}disabled{% endunless %}>
            {% render 'icon', name: 'cart' %}
            <span data-btn-text>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {% endform %}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'trust' -%}
            <div class="product-trust" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign line_key = 'line_' | append: i -%}
                {%- assign txt = block.settings[line_key] -%}
                {%- if txt != blank -%}
                  <div class="product-trust__item">{% render 'icon', name: 'check' %}<span>{{ txt }}</span></div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'sku' -%}
            <p class="text-muted" style="font-size:0.85rem;margin-top:0.75rem;" {{ block.shopify_attributes }}>
              {{ 'products.product.sku' | t }}: <span data-sku>{{ current_variant.sku }}</span>
            </p>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} -------------------- Description / accordions -------------------- {%- endcomment -%}
      {%- if desc_pos == 'right' -%}{{ product_accordion }}{%- endif -%}
    </div>
  </div>

  {%- if desc_pos == 'below' -%}
    <div class="section" style="max-width:900px;">{{ product_accordion }}</div>
  {%- endif -%}

  {%- comment -%} ------------------------ Variant data JSON ------------------------ {%- endcomment -%}
  <script type="application/json" data-variant-json>
    [
      {%- for variant in product.variants -%}
        {%- capture variant_unit_price -%}{% render 'unit-price', variant: variant %}{%- endcapture -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available }},
          "sku": {{ variant.sku | json }},
          "unit_price": {{ variant_unit_price | strip | json }},
          "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }}, "src": {{ variant.featured_media | image_url: width: 1200 | json }} }{% else %}null{% endif %},
          "metafields": {
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  {% if vendor_text != blank %}"brand": { "@type": "Brand", "name": {{ vendor_text | json }} },{% endif %}
  "sku": {{ current_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Produkt",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Marke anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "vendor_metafield_keys",
      "label": "Metafelder für die Markenzeile",
      "default": "hersteller,marke",
      "info": "Kommagetrennt, in dieser Reihenfolge geprüft. Angezeigt wird das erste Feld mit Inhalt, gesucht zuerst an der Variante, dann am Produkt. Ist keines gefüllt, greift der Anbieter des Produkts. Namespace wie unten bei den Metafeldern."
    },
    {
      "type": "text",
      "id": "vendor_metafield_namespace",
      "label": "Namespace der Markenzeile",
      "default": "custom",
      "info": "Namespace der oben genannten Metafelder, in der Regel custom."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Express-Checkout Buttons anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Produktbilder"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Bildformat",
      "options": [
        {
          "value": "natural",
          "label": "Wie hochgeladen"
        },
        {
          "value": "square",
          "label": "Quadratisch 1:1"
        },
        {
          "value": "portrait_45",
          "label": "Hochformat 4:5"
        },
        {
          "value": "portrait_34",
          "label": "Hochformat 3:4"
        },
        {
          "value": "landscape_43",
          "label": "Querformat 4:3"
        },
        {
          "value": "landscape_169",
          "label": "Querformat 16:9"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Bild im Format",
      "options": [
        {
          "value": "cover",
          "label": "Format füllen, Ränder werden beschnitten"
        },
        {
          "value": "contain",
          "label": "Bild vollständig zeigen"
        }
      ],
      "default": "cover",
      "info": "Bei Freistellern mit viel Rand ist „vollständig zeigen\" die sichere Wahl."
    },
    {
      "type": "select",
      "id": "description_position",
      "label": "Produktbeschreibung",
      "default": "right",
      "options": [
        {
          "value": "below",
          "label": "Unter dem Produkt, volle Breite"
        },
        {
          "value": "right",
          "label": "Rechte Spalte unter den Kaufoptionen"
        }
      ]
    },
    {
      "type": "select",
      "id": "thumb_position",
      "label": "Vorschaubilder",
      "default": "left",
      "info": "Links steht eine senkrechte Leiste zum Scrollen. Auf dem Handy stehen sie immer unter dem Bild.",
      "options": [
        {
          "value": "below",
          "label": "Unter dem großen Bild"
        },
        {
          "value": "left",
          "label": "Links neben dem Bild"
        }
      ]
    },
    {
      "type": "range",
      "id": "thumb_width",
      "label": "Breite der Leiste links",
      "min": 60,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "thumbs_per_row",
      "label": "Vorschaubilder pro Reihe",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5,
      "info": "Gilt nur, wenn die Vorschaubilder unter dem Bild stehen."
    },
    {
      "type": "header",
      "content": "Variantenauswahl"
    },
    {
      "type": "paragraph",
      "content": "Alle Optionen des Produkts werden automatisch angezeigt, egal ob Gewicht, Farbe, Größe oder Jahrgang. Die Reihenfolge steuern Sie im Admin am Produkt."
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Darstellung",
      "options": [
        {
          "value": "theme",
          "label": "Wie in den Theme-Einstellungen"
        },
        {
          "value": "auto",
          "label": "Automatisch"
        },
        {
          "value": "pills",
          "label": "Kacheln"
        },
        {
          "value": "swatches",
          "label": "Farbfelder"
        },
        {
          "value": "dropdown",
          "label": "Auswahlliste"
        }
      ],
      "default": "theme"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Hinweis unter dem Preis",
      "info": "Optionaler Text direkt unter dem Preis."
    },
    {
      "type": "header",
      "content": "Produktdetails (Metafelder)"
    },
    {
      "type": "paragraph",
      "content": "Alle Metafelder erscheinen gebündelt unter „Produktdetails\". Füge unten Blöcke hinzu: „Variantenmetafeld\" (aktualisiert sich beim Variantenwechsel) oder „Produktmetafeld\" (gilt fürs ganze Produkt). Reihenfolge per Drag & Drop. Angezeigt wird nur, was am Produkt oder an der Variante einen Wert hat. Fehlt der Wert an der Variante, greift der Wert am Produkt. Zum Einrichten lässt sich unten einblenden, welche Felder noch leer sind. Alternativ unten „Automatisch anzeigen\" aktivieren."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "collapsible",
      "name": "Aufklappbarer Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Versand und Lieferung"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Inhalt",
          "default": "<p>Lieferung innerhalb von 2 bis 3 Tagen mit DHL. Ab 50 Euro versandkostenfrei innerhalb Deutschlands.</p>"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Vertrauens-Hinweise",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "line_1",
          "label": "Zeile 1",
          "default": "Kauf auf Rechnung möglich"
        },
        {
          "type": "text",
          "id": "line_2",
          "label": "Zeile 2",
          "default": "Versandkostenfrei ab 50 Euro"
        },
        {
          "type": "text",
          "id": "line_3",
          "label": "Zeile 3",
          "default": "3 Prozent Rabatt bei Vorkasse"
        },
        {
          "type": "text",
          "id": "line_4",
          "label": "Zeile 4",
          "default": "Persönliche Beratung per Telefon"
        }
      ]
    },
    {
      "type": "sku",
      "name": "Artikelnummer",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}
