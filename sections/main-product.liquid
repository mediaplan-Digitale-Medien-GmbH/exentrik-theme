{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_ratio = section.settings.media_ratio | default: 'square'
  case gallery_ratio
    when 'natural'
      assign gallery_ratio_css = ''
    when 'portrait_45'
      assign gallery_ratio_css = '4 / 5'
    when 'portrait_34'
      assign gallery_ratio_css = '3 / 4'
    when 'landscape_43'
      assign gallery_ratio_css = '4 / 3'
    when 'landscape_169'
      assign gallery_ratio_css = '16 / 9'
    else
      assign gallery_ratio_css = '1 / 1'
  endcase
  assign gallery_fit = section.settings.media_fit | default: 'cover'
  assign gallery_thumbs = section.settings.thumbs_per_row | default: 5
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

<div class="page-width product-page" data-variant-selector>
  <nav class="breadcrumb text-muted" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Start</a>
    {%- if collection %} <span>/</span> <a href="{{ collection.url }}">{{ collection.title }}</a>{%- endif -%}
    <span>/</span> <span>{{ product.title | truncate: 50 }}</span>
  </nav>

  <div class="product">
    {%- comment -%} -------------------------- Gallery -------------------------- {%- endcomment -%}
    <div class="product-gallery{% if gallery_ratio_css != blank %} product-gallery--ratio{% endif %}" data-gallery style="--pg-fit: {{ gallery_fit }}; --pg-thumbs: {{ gallery_thumbs }};{% if gallery_ratio_css != blank %} --pg-ratio: {{ gallery_ratio_css }};{% endif %}">
      <div class="product-gallery__main media">
        {%- if product.featured_media -%}
          <img
            data-gallery-main
            src="{{ product.featured_media | image_url: width: 1200 }}"
            srcset="{{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w, {{ product.featured_media | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 990px) 100vw, 55vw"
            alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            loading="eager">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="product-gallery__thumb {% if forloop.first %}is-active{% endif %}"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              data-full="{{ media | image_url: width: 1200 }}"
              data-srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w"
              aria-label="Bild {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} -------------------------- Info -------------------------- {%- endcomment -%}
    <div class="product-info {% if settings.product_sticky_info %}product-info--sticky{% endif %}">
      {%- comment -%}
        Markenzeile ueber dem Titel. Es gewinnt das erste gefuellte Metafeld aus
        vendor_metafield_keys, gesucht zuerst an der Variante, dann am Produkt.
        Ist keines gefuellt, greift der Anbieter aus dem Produkt.
      {%- endcomment -%}
      {%- assign vendor_text = '' -%}
      {%- assign vendor_ns = section.settings.product_metafields_namespace | default: 'custom' -%}
      {%- assign vendor_keys = section.settings.vendor_metafield_keys | default: 'hersteller,marke' | split: ',' -%}
      {%- for vendor_raw_key in vendor_keys -%}
        {%- if vendor_text == blank -%}
          {%- assign vendor_key = vendor_raw_key | strip -%}
          {%- if vendor_key != blank -%}
            {%- assign vendor_mf = current_variant.metafields[vendor_ns][vendor_key] -%}
            {%- capture vendor_val -%}{{ vendor_mf }}{%- endcapture -%}
            {%- assign vendor_val = vendor_val | strip -%}
            {%- if vendor_val == blank or vendor_val == 'null' -%}
              {%- assign vendor_mf = product.metafields[vendor_ns][vendor_key] -%}
              {%- capture vendor_val -%}{{ vendor_mf }}{%- endcapture -%}
              {%- assign vendor_val = vendor_val | strip -%}
            {%- endif -%}
            {%- if vendor_val != blank and vendor_val != 'null' -%}
              {%- assign vendor_text = vendor_val -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if vendor_text == blank -%}
        {%- assign vendor_text = product.vendor -%}
      {%- endif -%}
      {%- if vendor_text != blank and section.settings.show_vendor -%}
        <div class="product-info__vendor">{{ vendor_text }}</div>
      {%- endif -%}
      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- comment -%}
        App-Bloecke stehen zwischen Titel und Preis, weil dort das Bewertungs-
        Badge von Judge.me erwartet wird. Sie laufen deshalb nicht mehr in der
        Blockschleife am Ende der Spalte mit.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="product-app-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      <div class="product-info__price" data-price>
        {%- if on_sale -%}
          <span class="price price--on-sale"><span class="price__sale">{{ current_variant.price | money }}</span> <span class="price__regular">{{ current_variant.compare_at_price | money }}</span></span>
        {%- else -%}
          <span class="price">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>
      <div class="product-info__unit price__unit" data-unit-price {% unless current_variant.unit_price_measurement %}hidden{% endunless %}>
        {%- if current_variant.unit_price_measurement -%}{% render 'unit-price', variant: current_variant %}{%- endif -%}
      </div>

      <div class="product-info__tax">{{ 'products.product.incl_tax' | t }}, {{ 'products.product.plus_shipping' | t }}</div>
      {%- if section.settings.price_note != blank -%}
        <p class="product-info__price-note">{{ section.settings.price_note }}</p>
      {%- endif -%}

      <div class="stock-status {% if current_variant.available %}stock-status--in{% else %}stock-status--out{% endif %}" data-stock>
        <span class="stock-status__dot"></span>
        {% if current_variant.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.out_of_stock' | t }}{% endif %}
      </div>

      {%- comment -%} -------------------------- Form -------------------------- {%- endcomment -%}
      {% form 'product', product, data-product-form: true, data-ajax-cart: true %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {% render 'variant-picker', product: product, section_id: section.id, style: section.settings.variant_style %}

        <div class="quantity-row">
          <div class="quantity-selector" data-quantity>
            <button type="button" data-qty-step="-1" aria-label="Menge verringern">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-step="1" aria-label="Menge erhöhen">+</button>
          </div>
        </div>

        <div class="product-form__buttons">
          <button type="submit" name="add" class="btn btn--primary btn--atc btn--large btn--full" data-add-btn {% unless current_variant.available %}disabled{% endunless %}>
            {% render 'icon', name: 'cart' %}
            <span data-btn-text>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {% endform %}

      {%- comment -%} -------------------- Produktdetails (Metafelder) -------------------- {%- endcomment -%}
      {%- assign pmf_auto = section.settings.product_metafields_auto -%}
      {%- assign vmf_auto = section.settings.variant_metafields_auto -%}
      {%- assign pmf_ns = section.settings.product_metafields_namespace | default: 'custom' -%}
      {%- comment -%}
        Schluesselliste fuer die automatische Variantenanzeige. Die Vereinigung ueber alle
        Varianten sorgt dafuer, dass auch ein Feld eine Zeile bekommt, das nur an einer
        einzelnen Variante gepflegt ist. Felder mit eigenem Block bleiben aussen vor, sonst
        stuenden sie doppelt da. Die Pipes ringsum machen den contains-Test eindeutig.
      {%- endcomment -%}
      {%- assign vmf_manual = '|' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'variant_metafield' and block.settings.key != blank and block.settings.namespace == pmf_ns -%}
          {%- assign vmf_manual = vmf_manual | append: block.settings.key | append: '|' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign vmf_keys = '|' -%}
      {%- if vmf_auto -%}
        {%- for v in product.variants -%}
          {%- for field in v.metafields[pmf_ns] -%}
            {%- capture vmf_probe -%}|{{ field.first }}|{%- endcapture -%}
            {%- unless vmf_keys contains vmf_probe or vmf_manual contains vmf_probe -%}
              {%- assign vmf_keys = vmf_keys | append: field.first | append: '|' -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign vmf_list = vmf_keys | split: '|' -%}
      {%- comment -%}
        Metafelder ohne Wert werden immer ausgeblendet, im Shop wie im
        Theme-Editor. Es gibt dafuer bewusst keine Einstellung mehr.
      {%- endcomment -%}
      {%- assign has_details = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'variant_metafield' or block.type == 'product_metafield' -%}{%- assign has_details = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if pmf_auto or vmf_auto -%}{%- assign has_details = true -%}{%- endif -%}
      {%- if has_details -%}
        <div class="product-details" data-product-details>
          {%- if section.settings.product_metafields_title != blank -%}
            <div class="product-details__title">{{ section.settings.product_metafields_title }}</div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'variant_metafield' -%}
              {%- assign mf = current_variant.metafields[block.settings.namespace][block.settings.key] -%}
              {%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- assign mfval = mfval | strip -%}
              {%- assign mf_empty = false -%}
              {%- comment -%}Ohne Wert an der Variante zaehlt der Wert am Produkt.{%- endcomment -%}
              {%- if mfval == blank or mfval == 'null' -%}{%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}{%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- assign mfval = mfval | strip -%}{%- endif -%}
              {%- if mfval == blank or mfval == 'null' -%}{%- assign mf_empty = true -%}{%- endif -%}
              {%- assign mf_hide = false -%}
              {%- if mf_empty -%}{%- assign mf_hide = true -%}{%- assign mfval = '' -%}{%- endif -%}
              <div class="product-details__row" data-vmf="{{ block.id }}"{% if mf_hide %} hidden{% endif %} {{ block.shopify_attributes }}>
                <div class="product-details__key">{{ block.settings.label }}{% if request.design_mode %}<span class="product-details__ref">{{ block.settings.namespace }}.{{ block.settings.key }}</span>{% endif %}</div>
                <div class="product-details__value" data-vmf-value>{{ mfval }}</div>
              </div>
            {%- elsif block.type == 'product_metafield' -%}
              {%- assign pmf = product.metafields[block.settings.namespace][block.settings.key] -%}
              {%- capture pmfval -%}{{ pmf }}{%- endcapture -%}{%- assign pmfval = pmfval | strip -%}
              {%- assign pmf_empty = false -%}
              {%- if pmfval == blank or pmfval == 'null' -%}{%- assign pmf_empty = true -%}{%- endif -%}
              {%- if pmf_empty == false -%}
                <div class="product-details__row" {{ block.shopify_attributes }}>
                  <div class="product-details__key">{{ block.settings.label }}{% if request.design_mode %}<span class="product-details__ref">{{ block.settings.namespace }}.{{ block.settings.key }}</span>{% endif %}</div>
                  <div class="product-details__value">{{ pmfval }}</div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if vmf_auto -%}
            {%- for vk in vmf_list -%}
              {%- if vk != blank -%}
                {%- assign vaf = current_variant.metafields[pmf_ns][vk] -%}
                {%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}
                {%- if vafval == blank or vafval == 'null' -%}{%- assign vaf = product.metafields[pmf_ns][vk] -%}{%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}{%- endif -%}
                {%- assign vaf_empty = false -%}
                {%- if vafval == blank or vafval == 'null' -%}{%- assign vaf_empty = true -%}{%- endif -%}
                {%- assign vaf_hide = false -%}
                {%- if vaf_empty -%}{%- assign vaf_hide = true -%}{%- assign vafval = '' -%}{%- endif -%}
                <div class="product-details__row" data-vmf="auto-{{ vk }}"{% if vaf_hide %} hidden{% endif %}>
                  <div class="product-details__key">{{ vk | replace: '_', ' ' | capitalize }}{% if request.design_mode %}<span class="product-details__ref">{{ pmf_ns }}.{{ vk }}</span>{% endif %}</div>
                  <div class="product-details__value" data-vmf-value>{{ vafval }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if pmf_auto -%}
            {%- comment -%} Compliance-Felder (GPSR, DSGVO, EU-Verantwortlicher) immer ans Ende {%- endcomment -%}
            {%- for pass in (1..2) -%}
              {%- for field in product.metafields[pmf_ns] -%}
                {%- assign av = field.last -%}{%- capture av -%}{{ av }}{%- endcapture -%}{%- assign av = av | strip -%}
                {%- if av != blank and av != 'null' -%}
                  {%- assign fk = field.first | downcase -%}
                  {%- assign is_compliance = false -%}
                  {%- if fk contains 'gpsr' or fk contains 'dsgvo' -%}{%- assign is_compliance = true -%}{%- endif -%}
                  {%- if fk contains 'antwort' or fk contains 'responsible' -%}{%- assign is_compliance = true -%}{%- endif -%}
                  {%- assign show_now = false -%}
                  {%- if pass == 1 and is_compliance == false -%}{%- assign show_now = true -%}{%- endif -%}
                  {%- if pass == 2 and is_compliance -%}{%- assign show_now = true -%}{%- endif -%}
                  {%- comment -%}Steht das Feld schon als Variantenzeile, nicht noch einmal ausgeben.{%- endcomment -%}
                  {%- capture pmf_probe -%}|{{ field.first }}|{%- endcapture -%}
                  {%- if vmf_keys contains pmf_probe or vmf_manual contains pmf_probe -%}{%- assign show_now = false -%}{%- endif -%}
                  {%- if show_now -%}
                    <div class="product-details__row">
                      <div class="product-details__key">{{ field.first | replace: '_', ' ' | capitalize }}</div>
                      <div class="product-details__value">{{ av }}</div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} -------------------- Additional blocks -------------------- {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'trust' -%}
            <div class="product-trust" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign line_key = 'line_' | append: i -%}
                {%- assign txt = block.settings[line_key] -%}
                {%- if txt != blank -%}
                  <div class="product-trust__item">{% render 'icon', name: 'check' %}<span>{{ txt }}</span></div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'sku' -%}
            <p class="text-muted" style="font-size:0.85rem;margin-top:0.75rem;" {{ block.shopify_attributes }}>
              {{ 'products.product.sku' | t }}: <span data-sku>{{ current_variant.sku }}</span>
            </p>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} -------------------- Description / accordions -------------------- {%- endcomment -%}
      <div class="product-accordion">
        {%- if product.description != blank -%}
          <details class="product-accordion__item" open>
            <summary class="product-accordion__summary">{{ 'products.product.description' | t }} {% render 'icon', name: 'chevron-down' %}</summary>
            <div class="product-accordion__content rte">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'collapsible' -%}
            <details class="product-accordion__item" {{ block.shopify_attributes }}>
              <summary class="product-accordion__summary">{{ block.settings.title }} {% render 'icon', name: 'chevron-down' %}</summary>
              <div class="product-accordion__content rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ------------------------ Variant data JSON ------------------------ {%- endcomment -%}
  <script type="application/json" data-variant-json>
    [
      {%- for variant in product.variants -%}
        {%- capture variant_unit_price -%}{% render 'unit-price', variant: variant %}{%- endcapture -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available }},
          "sku": {{ variant.sku | json }},
          "unit_price": {{ variant_unit_price | strip | json }},
          "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }}, "src": {{ variant.featured_media | image_url: width: 1200 | json }} }{% else %}null{% endif %},
          "metafields": {
            {%- assign first_mf = true -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'variant_metafield' -%}
                {%- unless first_mf %},{% endunless -%}{%- assign first_mf = false -%}
                {%- assign mf = variant.metafields[block.settings.namespace][block.settings.key] -%}
                {%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- assign mfval = mfval | strip -%}{%- if mfval == blank or mfval == 'null' -%}{%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}{%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- endif -%}
                {{ block.id | json }}: {{ mfval | strip | json }}
              {%- endif -%}
            {%- endfor -%}
            {%- if vmf_auto -%}
              {%- for vk in vmf_list -%}
                {%- if vk != blank -%}
                  {%- unless first_mf %},{% endunless -%}{%- assign first_mf = false -%}
                  {%- assign vaf = variant.metafields[pmf_ns][vk] -%}
                  {%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}
                  {%- if vafval == blank or vafval == 'null' -%}{%- assign vaf = product.metafields[pmf_ns][vk] -%}{%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}{%- endif -%}
                  {%- if vafval == 'null' -%}{%- assign vafval = '' -%}{%- endif -%}
                  {%- capture vaf_key -%}auto-{{ vk }}{%- endcapture -%}
                  {{ vaf_key | json }}: {{ vafval | json }}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  {% if vendor_text != blank %}"brand": { "@type": "Brand", "name": {{ vendor_text | json }} },{% endif %}
  "sku": {{ current_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Produkt",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Marke anzeigen", "default": true },
    { "type": "text", "id": "vendor_metafield_keys", "label": "Metafelder für die Markenzeile", "default": "hersteller,marke", "info": "Kommagetrennt, in dieser Reihenfolge geprüft. Angezeigt wird das erste Feld mit Inhalt, gesucht zuerst an der Variante, dann am Produkt. Ist keines gefüllt, greift der Anbieter des Produkts. Namespace wie unten bei den Metafeldern." },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout Buttons anzeigen", "default": true },
    { "type": "header", "content": "Produktbilder" },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "natural", "label": "Wie hochgeladen" },
        { "value": "square", "label": "Quadratisch 1:1" },
        { "value": "portrait_45", "label": "Hochformat 4:5" },
        { "value": "portrait_34", "label": "Hochformat 3:4" },
        { "value": "landscape_43", "label": "Querformat 4:3" },
        { "value": "landscape_169", "label": "Querformat 16:9" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Bild im Format",
      "options": [
        { "value": "cover", "label": "Format füllen, Ränder werden beschnitten" },
        { "value": "contain", "label": "Bild vollständig zeigen" }
      ],
      "default": "cover",
      "info": "Bei Freistellern mit viel Rand ist „vollständig zeigen\" die sichere Wahl."
    },
    { "type": "range", "id": "thumbs_per_row", "label": "Vorschaubilder pro Reihe", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "header", "content": "Variantenauswahl" },
    { "type": "paragraph", "content": "Alle Optionen des Produkts werden automatisch angezeigt, egal ob Gewicht, Farbe, Größe oder Jahrgang. Die Reihenfolge steuern Sie im Admin am Produkt." },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Darstellung",
      "options": [
        { "value": "theme", "label": "Wie in den Theme-Einstellungen" },
        { "value": "auto", "label": "Automatisch" },
        { "value": "pills", "label": "Kacheln" },
        { "value": "swatches", "label": "Farbfelder" },
        { "value": "dropdown", "label": "Auswahlliste" }
      ],
      "default": "theme"
    },
    { "type": "text", "id": "price_note", "label": "Hinweis unter dem Preis", "info": "Optionaler Text direkt unter dem Preis." },
    { "type": "header", "content": "Produktdetails (Metafelder)" },
