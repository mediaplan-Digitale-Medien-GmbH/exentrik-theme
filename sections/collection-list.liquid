<div class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center" reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- capture cat_sizes -%}(max-width: 749px) 92vw, (max-width: 990px) 46vw, {{ 92 | divided_by: section.settings.columns }}vw{%- endcapture -%}
    <div class="grid grid--{{ section.settings.columns }} grid--1-mobile">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        <a href="{{ coll.url | default: '#' }}" class="brand-card" style="min-height:260px;" reveal {{ block.shopify_attributes }}>
          <div class="brand-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="{{ cat_sizes }}" alt="{{ coll.title | escape }}" loading="lazy">
            {%- elsif coll.featured_image != blank -%}
              <img src="{{ coll.featured_image | image_url: width: 600 }}" srcset="{{ coll.featured_image | image_url: width: 300 }} 300w, {{ coll.featured_image | image_url: width: 450 }} 450w, {{ coll.featured_image | image_url: width: 600 }} 600w, {{ coll.featured_image | image_url: width: 900 }} 900w, {{ coll.featured_image | image_url: width: 1200 }} 1200w" sizes="{{ cat_sizes }}" alt="{{ coll.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="brand-card__body">
            <h3 class="brand-card__name" style="font-size:1.4rem;">{{ block.settings.title | default: coll.title }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kategorien",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Titel", "default": "Sortiment" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nach Kategorie einkaufen" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Spalten", "default": 3 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "title", "label": "Titel (optional)" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Kategorien",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
