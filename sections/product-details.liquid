{%- liquid
  assign pd_auto = section.settings.product_metafields_auto
  assign vd_auto = section.settings.variant_metafields_auto
  assign pd_ns = section.settings.product_metafields_namespace | default: 'custom'
  assign cur = product.selected_or_first_available_variant
  comment
    Schluesselliste fuer die automatische Variantenanzeige. Die Vereinigung ueber alle
    Varianten sorgt dafuer, dass auch ein Feld eine Zeile bekommt, das nur an einer
    einzelnen Variante gepflegt ist. Felder mit eigenem Block bleiben aussen vor, sonst
    stuenden sie doppelt da. Die Pipes ringsum machen den contains-Test eindeutig.
  endcomment
  assign vd_manual = '|'
  for block in section.blocks
    if block.type == 'variant_metafield' and block.settings.key != blank and block.settings.namespace == pd_ns
      assign vd_manual = vd_manual | append: block.settings.key | append: '|'
    endif
  endfor
  assign vd_keys = '|'
  if vd_auto
    for v in product.variants
      for field in v.metafields[pd_ns]
        assign vd_probe = field.first | prepend: '|' | append: '|'
        unless vd_keys contains vd_probe or vd_manual contains vd_probe
          assign vd_keys = vd_keys | append: field.first | append: '|'
        endunless
      endfor
    endfor
  endif
  assign vd_list = vd_keys | split: '|'
  comment
    Im Editor immer sichtbar, sonst lässt sich ein neu angelegtes Feld nicht
    befüllen. Im Shop bleiben leere Felder nur auf Wunsch sichtbar.
  endcomment
  assign has_details = false
  for block in section.blocks
    if block.type == 'variant_metafield' or block.type == 'product_metafield'
      assign has_details = true
    endif
  endfor
  if pd_auto or vd_auto
    assign has_details = true
  endif
-%}
{%- if product and has_details -%}
  <div class="section">
    <div class="page-width">
      <div class="product-details" data-product-details data-pd-section="{{ section.id }}">
        {%- if section.settings.product_metafields_title != blank -%}
          <div class="product-details__title">{{ section.settings.product_metafields_title }}</div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'variant_metafield' -%}
            {%- assign mf = cur.metafields[block.settings.namespace][block.settings.key] -%}
            {%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- assign mfval = mfval | strip -%}
            {%- assign mf_empty = false -%}
            {%- comment -%}Ohne Wert an der Variante zaehlt der Wert am Produkt.{%- endcomment -%}
            {%- if mfval == blank or mfval == 'null' -%}{%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}{%- capture mfval -%}{{ mf }}{%- endcapture -%}{%- assign mfval = mfval | strip -%}{%- endif -%}
            {%- if mfval == blank or mfval == 'null' -%}{%- assign mf_empty = true -%}{%- endif -%}
            {%- assign mf_hide = false -%}
            {%- if mf_empty -%}{%- assign mf_hide = true -%}{%- assign mfval = '' -%}{%- endif -%}
            <div class="product-details__row" data-vmf="{{ block.id }}"{% if mf_hide %} hidden{% endif %} {{ block.shopify_attributes }}>
              <div class="product-details__key">{{ block.settings.label | strip | remove_last: ':' }}:{% if request.design_mode %}<span class="product-details__ref">{{ block.settings.namespace }}.{{ block.settings.key }}</span>{% endif %}</div>
              <div class="product-details__value" data-vmf-value>{{ mfval }}</div>
            </div>
          {%- elsif block.type == 'product_metafield' -%}
            {%- assign pmf = product.metafields[block.settings.namespace][block.settings.key] -%}
            {%- capture pmfval -%}{{ pmf }}{%- endcapture -%}{%- assign pmfval = pmfval | strip -%}
            {%- assign pmf_empty = false -%}
            {%- if pmfval == blank or pmfval == 'null' -%}{%- assign pmf_empty = true -%}{%- endif -%}
            {%- if pmf_empty == false -%}
              <div class="product-details__row" {{ block.shopify_attributes }}>
                <div class="product-details__key">{{ block.settings.label | strip | remove_last: ':' }}:{% if request.design_mode %}<span class="product-details__ref">{{ block.settings.namespace }}.{{ block.settings.key }}</span>{% endif %}</div>
                <div class="product-details__value">{{ pmfval }}</div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if vd_auto -%}
          {%- for vk in vd_list -%}
            {%- if vk != blank -%}
              {%- assign vaf = cur.metafields[pd_ns][vk] -%}
              {%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}
              {%- if vafval == blank or vafval == 'null' -%}{%- assign vaf = product.metafields[pd_ns][vk] -%}{%- capture vafval -%}{{ vaf }}{%- endcapture -%}{%- assign vafval = vafval | strip -%}{%- endif -%}
              {%- assign vaf_empty = false -%}
              {%- if vafval == blank or vafval == 'null' -%}{%- assign vaf_empty = true -%}{%- endif -%}
              {%- assign vaf_hide = false -%}
              {%- if vaf_empty -%}{%- assign vaf_hide = true -%}{%- assign vafval = '' -%}{%- endif -%}
              <div class="product-details__row" data-vmf="auto-{{ vk }}"{% if vaf_hide %} hidden{% endif %}>
                <div class="product-details__key">{{ vk | replace: '_', ' ' | capitalize }}:{% if request.design_mode %}<span class="product-details__ref">{{ pd_ns }}.{{ vk }}</span>{% endif %}</div>
                <div class="product-details__value" data-vmf-value>{{ vafval }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if pd_auto -%}
          {%- comment -%} Compliance-Felder (GPSR, DSGVO, EU-Verantwortlicher) immer ans Ende {%- endcomment -%}
          {%- for pass in (1..2) -%}
            {%- for field in product.metafields[pd_ns] -%}
              {%- assign av = field.last -%}{%- capture av -%}{{ av }}{%- endcapture -%}{%- assign av = av | strip -%}
              {%- if av != blank and av != 'null' -%}
                {%- assign fk = field.first | downcase -%}
                {%- assign is_compliance = false -%}
                {%- if fk contains 'gpsr' or fk contains 'dsgvo' -%}{%- assign is_compliance = true -%}{%- endif -%}
                {%- if fk contains 'antwort' or fk contains 'responsible' -%}{%- assign is_compliance = true -%}{%- endif -%}
                {%- assign show_now = false -%}
                {%- if pass == 1 and is_compliance == false -%}{%- assign show_now = true -%}{%- endif -%}
                {%- if pass == 2 and is_compliance -%}{%- assign show_now = true -%}{%- endif -%}
                {%- comment -%}Steht das Feld schon als Variantenzeile, nicht noch einmal ausgeben.{%- endcomment -%}
                {%- assign pd_probe = field.first | prepend: '|' | append: '|' -%}
                {%- if vd_keys contains pd_probe or vd_manual contains pd_probe -%}{%- assign show_now = false -%}{%- endif -%}
                {%- if show_now -%}
                  <div class="product-details__row">
                    <div class="product-details__key">{{ field.first | replace: '_', ' ' | capitalize }}:</div>
                    <div class="product-details__value">{{ av }}</div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-pd-variants="{{ section.id }}">
    {
      {%- assign first_v = true -%}
      {%- for variant in product.variants -%}
        {%- unless first_v %},{% endunless -%}{%- assign first_v = false -%}
        {%- comment -%}Die ID muss als String raus, sonst ist der Objektschluessel kein gueltiges JSON.{%- endcomment -%}
        {%- capture pd_vid -%}{{ variant.id }}{%- endcapture -%}
        {{ pd_vid | json }}: {
          {%- assign first_m = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'variant_metafield' -%}
              {%- unless first_m %},{% endunless -%}{%- assign first_m = false -%}
              {%- assign mv = variant.metafields[block.settings.namespace][block.settings.key] -%}
              {%- capture mvs -%}{{ mv }}{%- endcapture -%}{%- assign mvs = mvs | strip -%}{%- if mvs == blank or mvs == 'null' -%}{%- assign mv = product.metafields[block.settings.namespace][block.settings.key] -%}{%- capture mvs -%}{{ mv }}{%- endcapture -%}{%- endif -%}
              {{ block.id | json }}: {{ mvs | strip | json }}
            {%- endif -%}
          {%- endfor -%}
          {%- if vd_auto -%}
            {%- for vk in vd_list -%}
              {%- if vk != blank -%}
                {%- unless first_m %},{% endunless -%}{%- assign first_m = false -%}
                {%- assign vav = variant.metafields[pd_ns][vk] -%}
                {%- capture vavs -%}{{ vav }}{%- endcapture -%}{%- assign vavs = vavs | strip -%}
                {%- if vavs == blank or vavs == 'null' -%}{%- assign vav = product.metafields[pd_ns][vk] -%}{%- capture vavs -%}{{ vav }}{%- endcapture -%}{%- assign vavs = vavs | strip -%}{%- endif -%}
                {%- if vavs == 'null' -%}{%- assign vavs = '' -%}{%- endif -%}
                {%- capture vav_key -%}auto-{{ vk }}{%- endcapture -%}
                {{ vav_key | json }}: {{ vavs | json }}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        }
      {%- endfor -%}
    }
  </script>
  <script>
    (function () {
      var root = document.querySelector('[data-pd-section="{{ section.id }}"]');
      var dataEl = document.querySelector('[data-pd-variants="{{ section.id }}"]');
      if (!root || !dataEl) return;
      var data = {};
      try { data = JSON.parse(dataEl.textContent); } catch (e) {}
      function apply(vid) {
        var vals = data[vid] || {};
        root.querySelectorAll('[data-vmf]').forEach(function (row) {
          var key = row.getAttribute('data-vmf');
          var val = vals[key];
          var has = !(val === undefined || val === null || val === '');
          var ve = row.querySelector('[data-vmf-value]');
          if (ve) ve.innerHTML = has ? val : '';
          row.hidden = !has;
        });
        // Bleibt keine Zeile uebrig, verschwindet der ganze Block samt Ueberschrift.
        var rows = root.querySelectorAll('.product-details__row');
        var visible = Array.prototype.some.call(rows, function (r) { return !r.hidden; });
        root.hidden = rows.length > 0 && !visible;
      }
      document.addEventListener('variant:change', function (e) {
        if (e.detail && e.detail.variantId) apply(e.detail.variantId);
      });
      var initial = {{ product.selected_or_first_available_variant.id | json }};
      if (initial) apply(initial);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Produktdetails",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "product_metafields_title", "label": "Titel", "default": "Produktdetails" },
    { "type": "paragraph", "content": "Füge Blöcke hinzu: „Variantenmetafeld\" (aktualisiert sich beim Variantenwechsel) oder „Produktmetafeld\" (gilt fürs ganze Produkt). Reihenfolge per Drag & Drop. Diese Sektion kannst du frei auf der Produktseite platzieren. Angezeigt wird nur, was am Produkt oder an der Variante einen Wert hat. Fehlt der Wert an der Variante, greift der Wert am Produkt." },
    { "type": "checkbox", "id": "product_metafields_auto", "label": "Alle Produktmetafelder automatisch anzeigen", "default": false },
    { "type": "checkbox", "id": "variant_metafields_auto", "label": "Alle Variantenmetafelder automatisch anzeigen", "default": false, "info": "Zeigt jedes gepflegte Metafeld der gewählten Variante und wechselt den Wert beim Variantenwechsel mit. Fehlt der Wert an der Variante, greift der Wert am Produkt. Felder mit eigenem Block erscheinen nicht doppelt." },
    { "type": "text", "id": "product_metafields_namespace", "label": "Namespace für automatische Anzeige", "default": "custom", "info": "Gilt für beide Automatiken, z. B. custom" }
  ],
  "blocks": [
    {
      "type": "variant_metafield",
      "name": "Variantenmetafeld",
      "settings": [
        { "type": "text", "id": "label", "label": "Anzeigename", "default": "Merkmal" },
        { "type": "text", "id": "namespace", "label": "Namespace", "default": "custom", "info": "z. B. custom" },
        { "type": "text", "id": "key", "label": "Key", "info": "Der Schlüssel des Metafelds, z. B. koernung" }
      ]
    },
    {
      "type": "product_metafield",
      "name": "Produktmetafeld",
      "settings": [
        { "type": "text", "id": "label", "label": "Anzeigename", "default": "Merkmal" },
        { "type": "text", "id": "namespace", "label": "Namespace", "default": "custom", "info": "z. B. custom" },
        { "type": "text", "id": "key", "label": "Key", "info": "Der Schlüssel des Produkt-Metafelds, z. B. herkunft" }
      ]
    }
  ],
  "presets": [{ "name": "Produktdetails" }]
}
{% endschema %}
