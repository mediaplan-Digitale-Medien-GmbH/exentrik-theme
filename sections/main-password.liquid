<div class="password-page">
  <div class="page-width">
    <div class="password-page__inner">
      {%- if settings.logo != blank -%}
        <img
          class="password-page__logo"
          src="{{ settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo_width | default: 160 }}"
          height="60"
          loading="eager">
      {%- else -%}
        <h1 class="password-page__title">{{ shop.name }}</h1>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="password-page__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="password-page__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {% form 'storefront_password', class: 'password-page__form' %}
        {%- if form.errors -%}
          <div class="password-page__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <label class="visually-hidden" for="Password">Passwort</label>
        <div class="password-page__row">
          <input
            type="password"
            name="password"
            id="Password"
            class="password-page__input"
            placeholder="{{ section.settings.placeholder | default: 'Passwort' }}"
            autocomplete="current-password"
            required>
          <button type="submit" class="btn btn--primary">
            {{ section.settings.button_label | default: 'Enter' }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Passwortseite",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Demnächst verfügbar" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dieser Shop ist noch nicht öffentlich. Bitte Passwort eingeben." },
    { "type": "text", "id": "placeholder", "label": "Platzhalter Passwortfeld", "default": "Passwort" },
    { "type": "text", "id": "button_label", "label": "Button Text", "default": "Enter" }
  ]
}
{% endschema %}
