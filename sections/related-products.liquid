{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign related_collection = product.collections.first
  assign has_recs = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_recs = true
  endif
  assign has_fallback = false
  if related_collection != blank and related_collection.products_count > 1
    assign has_fallback = true
  endif
-%}
{%- if has_recs or has_fallback -%}
  <div class="section">
    <div class="page-width">
      <div class="section-header" reveal>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="grid grid--{{ section.settings.columns }} grid--1-mobile">
        {%- if has_recs -%}
          {%- for product in recommendations.products limit: products_to_show -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- assign shown = 0 -%}
          {%- for p in related_collection.products -%}
            {%- if p.id != product.id and shown < products_to_show -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ähnliche Produkte",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das könnte Ihnen auch gefallen" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Anzahl Produkte", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Spalten", "default": 4 }
  ],
  "presets": [{ "name": "Ähnliche Produkte" }]
}
{% endschema %}
