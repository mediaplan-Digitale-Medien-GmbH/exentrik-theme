<div class="section">
  <div class="page-width">
    <div class="image-text {% if section.settings.layout == 'reverse' %}image-text--reverse{% endif %}">
      <div class="image-text__media" reveal>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="image-text__content" reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="image-text__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:1.5rem;">
            <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bild mit Text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    {
      "type": "select", "id": "layout", "label": "Bildposition",
      "options": [
        { "value": "normal", "label": "Bild links" },
        { "value": "reverse", "label": "Bild rechts" }
      ],
      "default": "normal"
    },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Titel", "default": "Über das Produkt" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Abschnittstitel" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ersetze diesen Platzhaltertext im Theme-Editor.</p>" },
    { "type": "text", "id": "button_label", "label": "Button Text" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "blocks": [
    { "type": "feature", "name": "Merkmal", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Vorteil oder Merkmal" } ] }
  ],
  "presets": [
    {
      "name": "Bild mit Text",
      "blocks": [
        { "type": "feature", "settings": { "text": "Vorteil 1" } },
        { "type": "feature", "settings": { "text": "Vorteil 2" } },
        { "type": "feature", "settings": { "text": "Vorteil 3" } }
      ]
    }
  ]
}
{% endschema %}
