<div class="page-width section" style="text-align:center;padding-block:clamp(48px,10vw,120px);">
  <div style="font-size:clamp(4rem,12vw,8rem);font-weight:var(--font-weight-heading);font-family:var(--font-heading);line-height:1;color:var(--color-accent);">404</div>
  <h1>{{ '404.title' | t }}</h1>
  <p class="text-muted" style="max-width:46ch;margin:0 auto 1.5rem;">{{ '404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn--primary btn--large">{{ '404.link' | t }}</a>
</div>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": []
}
{% endschema %}
