<script>
  window.THEME = window.THEME || {};
  window.THEME.currency = {{ cart.currency.iso_code | json }};
  window.THEME.strings = {
    addToCart: {{ 'products.product.add_to_cart' | t | json }},
    soldOut: {{ 'products.product.sold_out' | t | json }},
    unavailable: {{ 'products.product.unavailable' | t | json }},
    inStock: {{ 'products.product.in_stock' | t | json }},
    outOfStock: {{ 'products.product.out_of_stock' | t | json }},
    added: "Hinzugefügt"
  };
</script>

<header class="site-header" id="site-header" role="banner">
  <div class="page-width">
    <div class="site-header__inner">
      <button class="site-header__burger" type="button" data-open-menu aria-label="{{ 'accessibility.menu' | t }}" aria-controls="MobileDrawer">
        {% render 'icon', name: 'menu' %}
      </button>

      <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          <img
            class="brand__logo"
            src="{{ settings.logo | image_url: width: 440 }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            loading="eager">
        {%- else -%}
          <img
            class="brand__logo"
            src="{{ 'logo-exentrik.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="440"
            height="120"
            loading="eager">
        {%- endif -%}
      </a>

      {%- if section.settings.menu != blank -%}
        <nav class="site-header__nav" aria-label="{{ 'accessibility.menu' | t }}">
        {%- if section.settings.menu != blank -%}
          <ul class="main-nav">
            {%- for link in section.settings.menu.links -%}
              {%- liquid
                assign has_children = false
                if link.links.size > 0
                  assign has_children = true
                endif

                assign has_grandchildren = false
                for child in link.links
                  if child.links.size > 0
                    assign has_grandchildren = true
                  endif
                endfor

                assign is_mega = false
                if has_children
                  if section.settings.menu_style == 'mega'
                    assign is_mega = true
                  elsif section.settings.menu_style == 'dropdown'
                    assign is_mega = false
                  elsif has_grandchildren
                    assign is_mega = true
                  elsif link.links.size > 5
                    assign is_mega = true
                  endif
                endif
              -%}
              <li class="main-nav__item{% if has_children %} main-nav__item--sub{% endif %}{% if is_mega %} main-nav__item--mega{% endif %}">
                <a class="main-nav__link" href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>
                  {{ link.title }}
                  {%- if has_children %}{% render 'icon', name: 'chevron-down' %}{% endif -%}
                </a>

                {%- if is_mega -%}
                  <div class="mega">
                    <div class="mega__inner" style="--mega-columns: {{ section.settings.mega_columns | default: 4 }};">
                      <div class="mega__columns">
                        {%- for child in link.links -%}
                          <div class="mega__col">
                            <a class="mega__heading" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="mega__list">
                                {%- for grandchild in child.links -%}
                                  <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                      {%- assign promo_key = link.title | downcase | strip -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'mega_promo' -%}
                          {%- assign block_key = block.settings.menu_item | downcase | strip -%}
                          {%- if block_key == promo_key -%}
                            <div class="mega__promo" {{ block.shopify_attributes }}>
                              {%- if block.settings.image != blank -%}
                                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                              {%- endif -%}
                              {%- if block.settings.heading != blank -%}<p class="mega__promo-heading">{{ block.settings.heading }}</p>{%- endif -%}
                              {%- if block.settings.text != blank -%}<p class="mega__promo-text">{{ block.settings.text }}</p>{%- endif -%}
                              {%- if block.settings.link_label != blank -%}
                                <a class="mega__promo-link" href="{{ block.settings.link | default: link.url }}">{{ block.settings.link_label }}{% render 'icon', name: 'arrow-right' %}</a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- elsif has_children -%}
                  <div class="sub-nav">
                    <ul class="sub-nav__list">
                      {%- for child in link.links -%}
                        <li class="sub-nav__item">
                          <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="sub-nav__nested">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
      {%- endif -%}

      <div class="site-header__actions">
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary site-header__cta">{{ section.settings.cta_label }}</a>
        {%- endif -%}

        <button class="header__action" type="button" data-open-search aria-label="{{ 'accessibility.search' | t }}" aria-controls="SearchModal">
          {% render 'icon', name: 'search' %}
        </button>
        <a href="{{ routes.account_url }}" class="header__action" aria-label="{{ 'customer.account' | t }}">
          {% render 'icon', name: 'user' %}
        </a>
        <button class="cart-btn" type="button" data-open-cart aria-label="{{ 'accessibility.cart' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="cart-btn__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="drawer" id="MobileDrawer" aria-hidden="true">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
    <div class="drawer__header">
      <a href="{{ routes.root_url }}" class="brand">
        {%- if settings.logo != blank -%}
          <img class="brand__logo" src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}">
        {%- else -%}
          <img class="brand__logo" src="{{ 'logo-exentrik.png' | asset_url }}" alt="{{ shop.name | escape }}" width="320" height="88">
        {%- endif -%}
      </a>
      <button class="header__action" type="button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if section.settings.menu != blank -%}
      <nav class="drawer__nav">
        {%- if section.settings.menu != blank -%}
          <ul class="drawer-nav">
            {%- for link in section.settings.menu.links -%}
              <li>
                {%- if link.links.size > 0 -%}
                  <details class="drawer-nav__group"{% if link.child_active %} open{% endif %}>
                    <summary class="drawer-nav__summary">
                      <span>{{ link.title }}</span>
                      {% render 'icon', name: 'chevron-down' %}
                    </summary>
                    <ul class="drawer-nav__sub">
                      <li><a href="{{ link.url }}">Alle {{ link.title }}</a></li>
                      {%- for child in link.links -%}
                        <li>
                          {%- if child.links.size > 0 -%}
                            <details class="drawer-nav__group"{% if child.child_active %} open{% endif %}>
                              <summary class="drawer-nav__summary">
                                <span>{{ child.title }}</span>
                                {% render 'icon', name: 'chevron-down' %}
                              </summary>
                              <ul class="drawer-nav__sub">
                                <li><a href="{{ child.url }}">Alle {{ child.title }}</a></li>
                                {%- for grandchild in child.links -%}
                                  <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                                {%- endfor -%}
                              </ul>
                            </details>
                          {%- else -%}
                            <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    <div class="drawer__footer">
      <a href="{{ routes.account_url }}" class="btn btn--secondary btn--full" style="margin-bottom:0.75rem;">{% render 'icon', name: 'user' %} {{ 'customer.account' | t }}</a>
      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--full">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="search-modal" id="SearchModal" aria-hidden="true">
  <div class="search-modal__overlay" data-close></div>
  <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.search' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
      <input type="hidden" name="options[prefix]" value="last">
      <span aria-hidden="true">{% render 'icon', name: 'search' %}</span>
      <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" aria-label="{{ 'general.search.search' | t }}">
      <button type="button" class="header__action" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Kopfzeile",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hauptmenü",
      "default": "main-menu",
      "info": "Menü aus Onlineshop, Navigation. Drei Ebenen werden unterstützt: Menüpunkt, Unterpunkt und darunter noch eine Ebene."
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "Untermenüs",
      "options": [
        {
          "value": "auto",
          "label": "Automatisch"
        },
        {
          "value": "dropdown",
          "label": "Klappmenü"
        },
        {
          "value": "mega",
          "label": "Megamenü"
        }
      ],
      "default": "auto",
      "info": "Automatisch heißt: Sobald ein Menüpunkt eine dritte Ebene oder mehr als fünf Unterpunkte hat, wird daraus ein Megamenü, sonst bleibt es ein schlankes Klappmenü."
    },
    {
      "type": "range",
      "id": "mega_columns",
      "label": "Spalten im Megamenü",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Text",
      "default": "Jetzt kaufen"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Megamenü Aktion",
      "settings": [
        {
          "type": "paragraph",
          "content": "Erscheint rechts im Megamenü des gewählten Menüpunkts. Menüs mit drei Ebenen legen Sie im Admin unter Onlineshop, Navigation an."
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menüpunkt",
          "info": "Genau so schreiben wie im Menü, zum Beispiel Sortiment."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Linktext"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Ziel"
        }
      ]
    }
  ]
}
{% endschema %}
