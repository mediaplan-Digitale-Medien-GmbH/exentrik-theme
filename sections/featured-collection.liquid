<div class="section">
  <div class="page-width">
    <div class="section-header {% if section.settings.align == 'center' %}section-header--center{% endif %}" style="display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap;" reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 style="margin-bottom:0;">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section-header__text">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank and section.settings.show_view_all -%}
        <a href="{{ section.settings.collection.url }}" class="btn btn--secondary">{{ section.settings.view_all_label }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    {%- assign collection = section.settings.collection -%}
    <div class="grid grid--{{ section.settings.columns }} grid--1-mobile">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card">
            <div class="product-card__media ratio-square">{{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}</div>
            <div class="product-card__body"><h3 class="product-card__title">Beispielprodukt</h3></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Produkt-Slider",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Titel" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Beliebte Produkte" },
    { "type": "text", "id": "subheading", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Anzahl Produkte", "default": 4 },
    {
      "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Spalten (Desktop)", "default": 4
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Link zur Kollektion anzeigen", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Link Text", "default": "Alle ansehen" }
  ],
  "presets": [{ "name": "Produkt-Slider" }]
}
{% endschema %}
