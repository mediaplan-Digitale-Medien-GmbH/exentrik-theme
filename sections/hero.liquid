{%- liquid
  assign hero_video_src = ''
  assign hero_video_mp4 = ''
  if section.settings.video != blank
    for source in section.settings.video.sources
      if hero_video_src == blank
        assign hero_video_src = source.url
      endif
      if source.format == 'mp4' and hero_video_mp4 == blank
        assign hero_video_mp4 = source.url
      endif
    endfor
    if hero_video_mp4 != blank
      assign hero_video_src = hero_video_mp4
    endif
  endif
-%}

<div class="hero {% if section.settings.layout == 'center' %}hero--center{% endif %}" style="color: {{ section.settings.text_color }};">
  {%- if hero_video_src != blank or section.settings.image != blank -%}
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        <img
          class="hero__poster"
          src="{{ section.settings.image | image_url: width: 2400 }}"
          srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      {%- endif -%}
      {%- if hero_video_src != blank -%}
        <video
          class="hero__video"
          muted
          loop
          playsinline
          preload="none"
          {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}
          data-hero-video
          data-src="{{ hero_video_src }}"></video>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="hero__overlay" style="background: {{ section.settings.overlay_gradient }};"></div>

  <div class="page-width">
    <div class="hero__inner">
      <div class="hero__content" reveal>
        {%- if section.settings.show_logo and settings.logo != blank -%}
          <img
            class="hero__logo"
            src="{{ settings.logo | image_url: width: 880 }}"
            alt="{{ section.settings.heading | default: shop.name | escape }}"
            width="880"
            height="240"
            loading="eager">
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--large">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="btn btn--secondary btn--large" style="background:rgba(255,255,255,0.12);color:{{ section.settings.text_color }};border-color:currentColor;">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if hero_video_src != blank -%}
<script>
  (function () {
    var v = document.querySelector('#shopify-section-{{ section.id }} [data-hero-video]');
    if (!v) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var conn = navigator.connection || {};
    if (reduce || conn.saveData === true) return;

    function start() {
      if (v.dataset.loaded) return;
      v.dataset.loaded = '1';
      v.src = v.dataset.src;
      v.load();
      var play = function () {
        var p = v.play();
        if (p && p.then) {
          p.then(function () { v.classList.add('is-ready'); }).catch(function () {});
        } else {
          v.classList.add('is-ready');
        }
      };
      if (v.readyState >= 2) { play(); }
      else { v.addEventListener('canplay', play, { once: true }); }
    }

    function schedule() {
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          if (entries[0] && entries[0].isIntersecting) {
            io.disconnect();
            (window.requestIdleCallback || function (fn) { setTimeout(fn, 200); })(start);
          }
        }, { rootMargin: '200px' });
        io.observe(v);
      } else {
        setTimeout(start, 400);
      }
    }

    if (document.readyState === 'complete') { schedule(); }
    else { window.addEventListener('load', schedule); }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild / Poster" },
    { "type": "video", "id": "video", "label": "Hintergrundvideo (optional)", "info": "Überschreibt das Bild. Lädt verzögert nach dem Poster (IntersectionObserver / Idle). Bild dient als Vorschau." },
    {
      "type": "select",
      "id": "layout",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_logo", "label": "Logo im Hero anzeigen", "default": false, "info": "Nutzt das Logo aus den Theme-Einstellungen. Die Überschrift rückt dann darunter und wird kleiner gesetzt." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Titel", "default": "Willkommen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Shop-Titel hier" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Kurze Beschreibung deines Angebots. Ersetze diesen Platzhalter im Theme-Editor." },
    { "type": "text", "id": "button_label", "label": "Button 1 Text", "default": "Jetzt entdecken" },
    { "type": "url", "id": "button_link", "label": "Button 1 Link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 Text", "default": "Mehr erfahren" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 Link" },
    { "type": "header", "content": "Darstellung" },
    { "type": "color", "id": "text_color", "label": "Textfarbe", "default": "#ffffff" },
    { "type": "color_background", "id": "overlay_gradient", "label": "Overlay Verlauf", "default": "linear-gradient(90deg, rgba(13,17,23,0.75) 0%, rgba(13,17,23,0.2) 100%)" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
