<div class="page-width section">
  <a href="{{ routes.account_url }}" class="text-muted">&larr; {{ 'customer.account' | t }}</a>
  <h1 style="margin-top:1rem;">Bestellung {{ order.name }}</h1>
  <p class="text-muted">{{ order.created_at | date: '%d.%m.%Y %H:%M' }}</p>

  <div style="overflow-x:auto;margin-top:1.5rem;">
    <table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--color-border);">
          <th style="padding:0.6rem 0;">Produkt</th><th>Menge</th><th>Preis</th><th>Summe</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr style="border-bottom:1px solid var(--color-border);">
            <td style="padding:0.6rem 0;">{{ line_item.title }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="3" style="text-align:right;padding-top:1rem;">Zwischensumme</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        <tr><td colspan="3" style="text-align:right;">Versand</td><td>{{ order.shipping_price | money }}</td></tr>
        <tr><td colspan="3" style="text-align:right;font-weight:700;padding-top:0.5rem;">Gesamt</td><td style="font-weight:700;">{{ order.total_price | money }}</td></tr>
      </tfoot>
    </table>
  </div>
</div>
