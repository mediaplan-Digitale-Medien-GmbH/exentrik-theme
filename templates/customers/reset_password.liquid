<div class="page-width page-width--narrow section" style="max-width:460px;">
  <h1 style="text-align:center;">Neues Passwort</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="product-form__option">
      <label class="product-form__label" for="rpw">Neues Passwort</label>
      <input class="select" style="width:100%;" type="password" name="customer[password]" id="rpw" required>
    </div>
    <div class="product-form__option">
      <label class="product-form__label" for="rpw2">Passwort bestätigen</label>
      <input class="select" style="width:100%;" type="password" name="customer[password_confirmation]" id="rpw2" required>
    </div>
    <button type="submit" class="btn btn--primary btn--full">Passwort speichern</button>
  {%- endform -%}
</div>
