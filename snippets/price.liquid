{%- comment -%}
  Renders a product price.
  Accepts:
  - product: {Object} product or variant
  - show_from: {Boolean} show "ab" prefix for price range
{%- endcomment -%}
{%- liquid
  if product.price_varies
    assign price = product.price_min
  else
    assign price = product.price
  endif
  assign compare = product.compare_at_price
  assign on_sale = false
  if compare and compare > price
    assign on_sale = true
  endif

  assign unit_source = product.selected_or_first_available_variant | default: product
  assign show_unit = show_unit_price
  if show_unit_price == nil
    assign show_unit = true
  endif
-%}
<span class="price {% if on_sale %}price--on-sale{% endif %}" data-price-wrapper>
  {%- if product.price_varies and show_from -%}
    <span class="price__from">{{ 'products.product.from_price' | t: price: price | money }}</span>
  {%- else -%}
    {%- if on_sale -%}
      <span class="price__sale">{{ price | money }}</span>
      <span class="price__regular">{{ compare | money }}</span>
    {%- else -%}
      <span class="price__current">{{ price | money }}</span>
    {%- endif -%}
  {%- endif -%}
</span>
{%- if show_unit and unit_source.unit_price_measurement -%}
  <span class="price__unit">{% render 'unit-price', variant: unit_source %}</span>
{%- endif -%}
